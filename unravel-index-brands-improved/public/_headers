/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://images.squarespace-cdn.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  # script-src is 'self' only — no CDN. Google Fonts is the single external
  # dependency and it serves CSS + font files, never script. If a future page
  # needs a CDN script, vendor the file into public/ rather than widening this.

/dashboard.html
  X-Robots-Tag: noindex, nofollow

# The walkthrough is generated from dashboard.html with inline instrument and
# illustrative payload. It needs inline script, but no CDN runtime, eval, blob
# workers or remote API calls.
/marquee-demo.html
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://images.squarespace-cdn.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

/api/*
  Cache-Control: no-store
